version: 2

models:
  - name: {{ MODEL_NAME }}
    description: "Grain: {{ GRAIN }}."
    config:
      contract:
        enforced: true
      meta:
        owner: {{ OWNER }}
        domain: {{ DOMAIN }}
        data_product: {{ MODEL_NAME }}
        maturity: experimental
        contains_pii: false
        sla:
          freshness_minutes: {{ FRESHNESS_MINUTES }}
          availability: best_effort
        contract_policy: breaking_changes_blocked
    columns:
{{ COLUMN_YAML }}
