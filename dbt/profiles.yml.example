retail_data_platform:
  target: "{{ env_var('DBT_TARGET', 'local') }}"
  outputs:
    local:
      type: postgres
      host: "{{ env_var('POSTGRES_HOST', 'localhost') }}"
      port: "{{ env_var('POSTGRES_PORT', '5432') | int }}"
      dbname: "{{ env_var('POSTGRES_DB', 'streaming') }}"
      user: "{{ env_var('POSTGRES_USER', 'streaming') }}"
      password: "{{ env_var('POSTGRES_PASSWORD') }}"
      schema: "{{ env_var('DBT_TARGET_SCHEMA', 'analytics_local') }}"
      threads: "{{ env_var('DBT_THREADS', '4') | int }}"
      connect_timeout: 10
    ci:
      type: postgres
      host: "{{ env_var('POSTGRES_HOST', 'localhost') }}"
      port: "{{ env_var('POSTGRES_PORT', '5432') | int }}"
      dbname: "{{ env_var('POSTGRES_DB', 'streaming') }}"
      user: "{{ env_var('POSTGRES_USER', 'streaming') }}"
      password: "{{ env_var('POSTGRES_PASSWORD') }}"
      schema: "{{ env_var('DBT_TARGET_SCHEMA') }}"
      threads: "{{ env_var('DBT_THREADS', '4') | int }}"
      connect_timeout: 10
